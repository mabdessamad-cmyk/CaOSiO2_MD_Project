# x = 0.40

clear

units           metal
dimension       3
boundary        p p p
atom_style      charge

read_data       data/x040_glass_final_300K.data

include         ../lammps/forcefields/pedone_2006.in

neighbor        2.0 bin
neigh_modify    every 1 delay 0 check yes

# ------------------------------------------------------------
# Separate 300 K NVT trajectory for structural/RDF sampling
# ------------------------------------------------------------

timestep        0.001

velocity        all create 300.0 123456 mom yes rot yes dist gaussian

fix             rdf_nvt all nvt temp 300.0 300.0 0.1

# ------------------------------------------------------------
# Six partial RDFs
#
# Atom types:
#   1 = Si
#   2 = O
#   3 = Ca
#
# Order:
#   Si-Si
#   Si-O
#   Si-Ca
#   O-O
#   O-Ca
#   Ca-Ca
# ------------------------------------------------------------

compute rdfall all rdf 300 1 1 1 2 1 3 2 2 2 3 3 3

# Sample RDF every 0.1 ps.
# Average 100 samples = 10 ps.
# Write one averaged RDF vector every 10 ps.
#
# Two output vectors therefore correspond to:
#   block 1: 0-10 ps
#   block 2: 10-20 ps
#
fix             rdfout all ave/time 100 100 10000 c_rdfall[*] file rdf_x040_20ps_2x10ps.dat mode vector

thermo          10000

thermo_style    custom step time temp press pe ke etotal vol density

run             20000

unfix           rdfout
unfix           rdf_nvt
