# ==========================================================
# 08_partial_rdf.in
# Partial RDFs for CaO-SiO2 glass
# ==========================================================

units           metal
dimension       3
boundary        p p p
atom_style      charge

read_data       x020_glass_final_300K.data

# ----------------------------------------------------------
# Pedone force field
# ----------------------------------------------------------

pair_style hybrid/overlay pedone 15.0 coul/long 15.0
kspace_style pppm 1.0e-6

pair_coeff * * coul/long

pair_coeff 1 2 pedone 0.340554 2.006700 2.100000 1.0
pair_coeff 2 2 pedone 0.042395 1.379316 3.618701 22.0
pair_coeff 2 3 pedone 0.030211 2.241334 2.923245 5.0

pair_modify mix geometric

neighbor 2.0 bin
neigh_modify every 1 delay 0 check yes

# ----------------------------------------------------------
# Equilibrate at 300 K
# ----------------------------------------------------------

velocity all create 300.0 12345 mom yes rot yes dist gaussian

fix nvt all nvt temp 300.0 300.0 0.1

# ----------------------------------------------------------
# Partial RDFs
# ----------------------------------------------------------

compute rdf all rdf 300 1 1 1 2 1 3 2 2 2 3 3 3

fix ave all ave/time 100 100 10000 c_rdf[*] mode vector file x020_partial_rdf_corrected.dat

thermo 1000
thermo_style custom step temp pe press

timestep 0.001

run 20000
