# ==========================================================
# x = 0.10 CaO - 0.90 SiO2
# 6496 atoms
# Pedone 2006
# Stage 2: NVT relaxation at 300 K
# ==========================================================

units           metal
dimension       3
boundary        p p p
atom_style      charge

read_data       minimized_x010_6496.data

# ----------------------------------------------------------
# Masses
# ----------------------------------------------------------

mass 1 28.0855
mass 2 15.9994
mass 3 40.078

# ----------------------------------------------------------
# Neighbor list
# ----------------------------------------------------------

neighbor        2.0 bin
neigh_modify    delay 0 every 1 check yes

# ----------------------------------------------------------
# Pedone potential
# ----------------------------------------------------------

pair_style hybrid/overlay pedone 15.0 coul/long 15.0

kspace_style pppm 1.0e-6

pair_coeff * * coul/long

pair_coeff 1 2 pedone 0.340554 2.006700 2.100000 1.0
pair_coeff 2 2 pedone 0.042395 1.379316 3.618701 22.0
pair_coeff 2 3 pedone 0.030211 2.241334 2.923245 5.0

# ----------------------------------------------------------
# Initial velocities
# ----------------------------------------------------------

reset_timestep 0

timestep 0.0005

velocity all create 300.0 12345 mom yes rot yes dist gaussian

# ----------------------------------------------------------
# NVT
# ----------------------------------------------------------

fix relax all nvt temp 300.0 300.0 0.1

# ----------------------------------------------------------
# Output
# ----------------------------------------------------------

thermo 100

thermo_style custom step temp pe ke etotal press density

dump d1 all custom 1000 x010_relax300.lammpstrj id type q x y z
dump_modify d1 sort id

restart 10000 x010_relax300.restart

# ----------------------------------------------------------
# Run
# ----------------------------------------------------------

run 40000

# ----------------------------------------------------------
# Save
# ----------------------------------------------------------

write_data x010_relax300.data
write_restart x010_relax300_final.restart
