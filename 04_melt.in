# ==========================================================
# x = 0.30 CaO - 0.70 SiO2
# 6480 atoms
# Pedone 2006
# Stage 4: Melt equilibration at 3500 K
# ==========================================================

units           metal
dimension       3
boundary        p p p
atom_style      charge

read_data       heat3500.data

# ----------------------------------------------------------
# Masses
# ----------------------------------------------------------

mass 1 28.0855
mass 2 15.9994
mass 3 40.078

# ----------------------------------------------------------
# Neighbor list
# ----------------------------------------------------------

neighbor        2.0 bin
neigh_modify    delay 0 every 1 check yes

# ----------------------------------------------------------
# Pedone potential
# ----------------------------------------------------------

pair_style hybrid/overlay pedone 15.0 coul/long 15.0

kspace_style pppm 1.0e-6

pair_coeff * * coul/long

pair_coeff 1 2 pedone 0.340554 2.006700 2.100000 1.0
pair_coeff 2 2 pedone 0.042395 1.379316 3.618701 22.0
pair_coeff 2 3 pedone 0.030211 2.241334 2.923245 5.0

# ----------------------------------------------------------
# Dynamics
# ----------------------------------------------------------

reset_timestep 0

timestep 0.0005

fix melt all npt temp 3500.0 3500.0 0.1 iso 0.0 0.0 1.0

# ----------------------------------------------------------
# Output
# ----------------------------------------------------------

thermo 1000

thermo_style custom step temp pe ke etotal press density vol lx ly lz

dump d1 all custom 1000 melt3500.lammpstrj id type q x y z
dump_modify d1 sort id

restart 50000 melt.restart

# ----------------------------------------------------------
# Melt equilibration
# ----------------------------------------------------------

run 200000

# ----------------------------------------------------------
# Save
# ----------------------------------------------------------

write_data melt3500.data
write_restart melt3500.restart
