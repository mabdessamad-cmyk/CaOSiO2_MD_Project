#======================================================================
# Pedone et al. (2006) PMMCS Force Field
#
# Reference:
# A. Pedone, G. Malavasi, M. C. Menziani,
# A. N. Cormack, U. Segre,
# J. Phys. Chem. B 110, 11780–11795 (2006)
#
# LAMMPS:
# pair_style pedone (29 Aug 2024)
#
# Units:
# units metal
#
# Atom types:
#   1 = Si
#   2 = O
#   3 = Ca
#
# Charges:
#   Si  +2.4
#   O   -1.2
#   Ca  +1.2
#======================================================================

pair_style hybrid/overlay pedone 15.0 coul/long 15.0

kspace_style pppm 1.0e-5

#--------------------------------------------------
# Coulomb interaction
#--------------------------------------------------

pair_coeff * * coul/long

#--------------------------------------------------
# Pedone short-range interactions
#
# pair_coeff i j pedone
#            D0 alpha r0 B0
#--------------------------------------------------

# Si-O
pair_coeff 1 2 pedone 0.340554 2.006700 2.100000 1.0

# O-O
pair_coeff 2 2 pedone 0.042395 1.379316 3.618701 22.0

# Ca-O
pair_coeff 2 3 pedone 0.030211 2.241334 2.923245 5.0
