LAMMPS (29 Aug 2024)
#======================================================================
# 02_npt_300K.in
#
# CaO–SiO2 glass
# NPT relaxation at 300 K
#
# Starting structure:
#   glass_54_minimized.data
#
# Force field:
#   Pedone et al. (2006)
#======================================================================

clear

units           metal
dimension       3
boundary        p p p
atom_style      charge

#--------------------------------------------------
# Read minimized structure
#--------------------------------------------------

read_data       data/glass_54_minimized.data nocoeff
Reading data file ...
  orthogonal box = (0 0 0) to (10.924184 10.924184 10.924184)
  1 by 1 by 1 MPI processor grid
  reading atoms ...
  54 atoms
  reading velocities ...
  54 velocities
  read_data CPU = 0.007 seconds

reset_timestep  0

#--------------------------------------------------
# Force field
#--------------------------------------------------

include         forcefields/pedone_2006.in
#======================================================================
# Pedone et al. (2006) PMMCS Force Field
#
# Reference:
# A. Pedone, G. Malavasi, M. C. Menziani,
# A. N. Cormack, U. Segre,
# J. Phys. Chem. B 110, 11780–11795 (2006)
#
# LAMMPS:
# pair_style pedone (29 Aug 2024)
#
# Units:
# units metal
#
# Atom types:
#   1 = Si
#   2 = O
#   3 = Ca
#
# Charges:
#   Si  +2.4
#   O   -1.2
#   Ca  +1.2
#======================================================================

pair_style hybrid/overlay pedone 15.0 coul/long 15.0

kspace_style pppm 1.0e-5

#--------------------------------------------------
# Coulomb interaction
#--------------------------------------------------

pair_coeff * * coul/long

#--------------------------------------------------
# Pedone short-range interactions
#
# pair_coeff i j pedone
#            D0 alpha r0 B0
#--------------------------------------------------

# Si-O
pair_coeff 1 2 pedone 0.340554 2.006700 2.100000 1.0

# O-O
pair_coeff 2 2 pedone 0.042395 1.379316 3.618701 22.0

# Ca-O
pair_coeff 2 3 pedone 0.030211 2.241334 2.923245 5.0

#--------------------------------------------------
# Neighbor list
#--------------------------------------------------

neighbor        2.0 bin
neigh_modify    every 1 delay 0 check yes

#--------------------------------------------------
# Time integration
#--------------------------------------------------

timestep        0.001      # 1 fs

velocity        all create 300.0 12345 mom yes rot yes dist gaussian

#--------------------------------------------------
# NPT ensemble
#--------------------------------------------------

fix             1 all npt temp 300.0 300.0 0.1 iso 0.0 0.0 1.0

#--------------------------------------------------
# Thermodynamic output
#--------------------------------------------------

thermo          100

thermo_style custom step temp pe ke etotal press density vol lx ly lz

thermo_modify   flush yes

#--------------------------------------------------
# Trajectory output
#--------------------------------------------------

dump            1 all custom 500 dump/npt_300K.lammpstrj id type q x y z

dump_modify     1 sort id

#--------------------------------------------------
# Restart files
#--------------------------------------------------

restart         10000 restart/npt_300K.*

#--------------------------------------------------
# Run
#--------------------------------------------------

run             20000

